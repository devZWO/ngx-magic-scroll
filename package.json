{
  "name": "@devzwo/ngx-magic-scroll-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "pnpm run lib:build && pnpm run demo:build && pnpm run docs:build",
    "lib:build": "ng build ngx-signal-scroll && node scripts/preserve-third-party-notices.mjs",
    "lib:watch": "ng build ngx-signal-scroll --watch --configuration development",
    "demo:build": "ng build demo",
    "demo:build:pages": "ng build demo --base-href /ngx-magic-scroll/demo/",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "lint": "eslint projects scripts playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm run lib:build && playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install",
    "e2e:install:deps": "playwright install-deps",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "package:check": "pnpm run lib:build && node pnpm pack ./dist/ngx-signal-scroll --dry-run",
    "release:check": "pnpm run lint && pnpm run test:ci && pnpm run build && pnpm run recipes:check && pnpm run e2e && pnpm run package:check",
    "recipes:check": "pnpm run lib:build && node scripts/check-recipes.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@ngrx/signals": "22.0.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/angular-query-experimental": "5.101.0",
    "@vitest/coverage-v8": "^5.0.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.3.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
